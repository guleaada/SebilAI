# ═══════════════════════════════════════════════
# SebilAI — Environment Variables
# Copy this file to .env and fill in your keys.
# ═══════════════════════════════════════════════

# ── AI PROVIDERS (at least one required) ──────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OpenRouter_API_KEY=your_openrouter_api_key_here

# ── ADMIN & AUTH ──────────────────────────────
# Strong password for admin/agronomist dashboards
ADMIN_KEY=change_this_to_a_strong_random_password

# JWT secret for /api/v2/auth token signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ── PUSH NOTIFICATIONS (optional) ─────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── SMS / AFRICA'S TALKING (optional) ─────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username

# ── SATELLITE / GOOGLE EARTH ENGINE (optional) ─
# JSON string of your GEE service account key file
# GEE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"..."}

# ── DATABASE & DATA PATHS (optional) ──────────
# Default: sebilai.db in repo root
# DB_PATH=/data/sebilai.db

# Default: /tmp/sebilai_data — use a persistent path in production
# DATA_DIR=/data/sebilai_data

# ── SERVER ────────────────────────────────────
PORT=3000
